{
  "trigger.message": {
    "label": "A message is received",
    "fields": [
      {
        "name": "textContains",
        "label": "Text contains",
        "kind": "text",
        "placeholder": "e.g. ping"
      },
      {
        "name": "regex",
        "label": "Text matches regex",
        "kind": "text",
        "placeholder": "e.g. (?i)^(test|ping)"
      },
      {
        "name": "senderKind",
        "label": "Sent by",
        "kind": "select",
        "options": [
          {
            "value": "human",
            "label": "People only (skip automated messages)"
          },
          {
            "value": "any",
            "label": "Anyone"
          },
          {
            "value": "automation",
            "label": "Automations only"
          }
        ]
      },
      {
        "name": "channels",
        "label": "On channels",
        "kind": "channelMulti"
      },
      {
        "name": "channelName",
        "label": "On channel (name)",
        "kind": "text",
        "placeholder": "any"
      },
      {
        "name": "channel",
        "label": "On channel #",
        "kind": "number",
        "placeholder": "any"
      },
      {
        "name": "from",
        "label": "From node #",
        "kind": "number",
        "placeholder": "any"
      },
      {
        "name": "includeMeshCoreReactions",
        "label": "Also fire on MeshCore reactions",
        "kind": "checkbox"
      },
      {
        "name": "cooldownSeconds",
        "label": "Cooldown (seconds)",
        "kind": "number",
        "placeholder": "0"
      },
      {
        "name": "cooldownScope",
        "label": "Cooldown applies to",
        "kind": "select",
        "options": [
          {
            "value": "automation",
            "label": "The whole automation (one shared timer)"
          },
          {
            "value": "node",
            "label": "Each node separately"
          },
          {
            "value": "sourceNode",
            "label": "Each node, per source"
          }
        ]
      }
    ]
  },
